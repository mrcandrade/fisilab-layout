<?xml version="1.0" encoding="utf-8"?>
<!--
  FisiLayout MSI (Suíte FisiLab; WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build fisilayout.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations are
  registered (the upstream DesignCraft MSI registered none either). The suite itself ships an Inno
  Setup installer built elsewhere; this MSI is kept for parity with the upstream packaging.
  UpgradeCode and component GUIDs differ from DesignCraft's, so it never upgrades or removes an
  upstream install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FisiLayout"
      Manufacturer="FisiLab — LARFIC/UFRGS"
      Version="$(var.Version)"
      UpgradeCode="26F02BAF-4595-41B8-BA63-0E9415065322"
      Scope="perMachine"
      Compressed="yes"
      Language="1046"
      Codepage="65001">
    <SummaryInformation Description="FisiLayout — Diagramação e editoração (Suíte FisiLab)" Manufacturer="FisiLab — LARFIC/UFRGS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais nova do FisiLayout já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FisilayoutIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FisilayoutIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mrcandrade/larfic/tree/main/suite-fisilab" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mrcandrade/fisilayout/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mrcandrade/fisilayout/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FisiLayout" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FisiLayout" Level="1">
      <ComponentGroupRef Id="FisilayoutFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FisilayoutFiles" Directory="INSTALLFOLDER">
      <Component Id="FisilayoutApp" Guid="5009D570-4A2D-456E-9F20-61ED7C5D19CD">
        <File Id="FisilayoutExe" Source="$(var.BinDir)\fisilayout.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FisiLayout"
              Description="FisiLayout — Diagramação e editoração (Suíte FisiLab)" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FisilayoutIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fisilayout.exe" Value="[#FisilayoutExe]" Type="string" />
      </Component>

      <Component Id="FisilayoutCli">
        <File Id="FisilayoutCliExe" Source="$(var.BinDir)\fisilayout-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
